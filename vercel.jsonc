{
  "headers": [
    {
      "source": "/(.*)",

      "headers": [
        {
          // Prevent iframe embedding
          "key": "X-Frame-Options",
          "value": "DENY"
        },

        {
          // Prevent MIME-type sniffing
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },

        {
          // Reduce referrer leakage
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },

        {
          /*
            Content Security Policy (CSP)

            Allow only trusted sources.
            External domains must be explicitly whitelisted.
          */
          "key": "Content-Security-Policy",

          /*
            connect-src
            -> APIs/fetch requests

            img-src
            -> external movie posters/images

            style-src
            -> Google Fonts CSS

            font-src
            -> Google Fonts font files

            script-src
            -> local scripts + Vercel live feedback script
          */
          "value": "default-src 'self'; connect-src 'self' https://api.themoviedb.org; img-src 'self' https://image.tmdb.org https: data:; script-src 'self' https://vercel.live; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;"
        }
      ]
    }
  ]
}
