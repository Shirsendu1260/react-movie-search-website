{
  "headers": [
    {
      // Apply headers to all routes
      "source": "/(.*)",

      "headers": [
        {
          // Prevent site from being embedded in iframes
          // Helps protect against clickjacking
          "key": "X-Frame-Options",
          "value": "DENY"
        },

        {
          // Prevent browser from guessing file types
          // Reduces risk of malicious file execution
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },

        {
          // Limit referrer data shared with external sites
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },

        {
          /*
            Content Security Policy (CSP)

            Restricts which external resources are allowed.
            Strong protection against XSS/script injection attacks.
          */
          "key": "Content-Security-Policy",

          /*
            default-src
            -> Default fallback policy

            connect-src
            -> Allow API/fetch requests to TMDB

            img-src
            -> Allow movie posters/images from TMDB & HTTPS

            script-src
            -> Allow local scripts + Vercel live feedback script

            style-src
            -> Allow Google Fonts CSS + inline styles

            font-src
            -> Allow Google font files

            frame-src
            -> Allow Vercel feedback iframe
          */
          "value": "default-src 'self'; connect-src 'self' https://api.themoviedb.org; img-src 'self' https://image.tmdb.org https: data:; script-src 'self' https://vercel.live; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; frame-src 'self' https://vercel.live;"
        }
      ]
    }
  ]
}
